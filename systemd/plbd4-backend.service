[Unit]
Description=HealthGate – Backend FastAPI (PLBD-4)
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi

# Répertoire racine du projet (adapter si cloné ailleurs)
WorkingDirectory=/home/pi/PLBD-4

# Activation du virtualenv Python puis lancement d'uvicorn
# --workers 1 : un seul worker pour conserver l'état WebSocket en mémoire
ExecStart=/home/pi/PLBD-4/.venv/bin/uvicorn backend.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1

# Redémarrage automatique en cas de crash (attente 5 s avant retry)
Restart=always
RestartSec=5

# Variables d'environnement (le fichier .env du projet sera chargé par python-dotenv)
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/PLBD-4

# Logs accessibles via : journalctl -u plbd4-backend -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plbd4-backend

[Install]
WantedBy=multi-user.target
